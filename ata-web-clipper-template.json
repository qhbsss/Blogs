{
  "schemaVersion": "0.1.0",
  "name": "ATA Article (DOM 精确提取)",
  "behavior": "create",
  "noteNameFormat": "{{selector:[class^=\"article_\"] > h1[class^=\"title_\"]|safe_name}}",
  "path": "Clippings/ATA",
  "properties": [
    {
      "name": "title",
      "value": "{{selector:[class^=\"article_\"] > h1[class^=\"title_\"]}}",
      "type": "text"
    },
    {
      "name": "source",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "author",
      "value": "{{selector:[class^=\"meta-author_\"] a}}",
      "type": "text"
    },
    {
      "name": "published_display",
      "value": "{{selector:[class^=\"meta-info_\"] > span:nth-child(1) > span}}",
      "type": "text"
    },
    {
      "name": "updated_display",
      "value": "{{selector:[class^=\"meta-info_\"] > span:nth-child(2) > span}}",
      "type": "text"
    },
    {
      "name": "clipped",
      "value": "{{date|date:\"YYYY-MM-DD\"}}",
      "type": "date"
    },
    {
      "name": "tags",
      "value": "ata, clipping",
      "type": "multitext"
    }
  ],
  "triggers": [
    "/^https:\\/\\/ata\\.atatech\\.org\\/articles\\/\\d+/"
  ],
  "noteContentFormat": "# {{selector:[class^=\"article_\"] > h1[class^=\"title_\"]}}\n\n> [!info] 文章信息\n> 作者：{{selector:[class^=\"meta-author_\"] a}}  \n> 发布：{{selector:[class^=\"meta-info_\"] > span:nth-child(1) > span}}  \n> 更新：{{selector:[class^=\"meta-info_\"] > span:nth-child(2) > span}}  \n> 来源：{{url}}\n\n{{selectorHtml:[class^=\"renderer_\"] .ding-renderer-container|markdown|replace:\"/●[\\n\\r\\t ]*/g\":\"- \"|replace:\"/\\n{3,}/g\":\"\\n\\n\"}}"
}
